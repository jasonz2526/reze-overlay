{
  "manifest_version": 3,
  "name": "Manga Overlay Translator",
  "version": "0.1.0",
  "description": "Drag-to-crop and overlay translations on manga pages.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "RezeOverlay",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-manga": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start manga capture using saved translation mode"
    },
    "capture-manga-simple": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start manga capture in simple mode"
    },
    "capture-manga-deep": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Start manga capture in deep mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["contentScript.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.js", "overlay.css", "fonts/*.otf", "fonts/*.woff2"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
  
